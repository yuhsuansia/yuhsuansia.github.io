<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      {% if content.title %}
        <h6 class="font-weight-bold">{{ content.title | escape }}</h6>
      {% endif %}
      {% if content.summary %}
        <p class="mb-0">{{ content.summary | escape }}</p>
      {% endif %}
      {% if content.items %}
        <ul class="items mb-0">
          {% for item in content.items %}
            <li>{{ item | escape }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
